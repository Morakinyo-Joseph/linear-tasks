# Linear Tasks — copy to .env and adjust

DEBUG=True
SECRET_KEY=django-insecure-dev-only-linear-tasks-change-me-32b
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Leave DB_NAME empty to use SQLite (db.sqlite3).
# Set these for Postgres:
# DB_NAME=linear_tasks
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Phase 2 — Insider SDK (beam into your StarLink / Insider project)
# Paste DSN from Insider project settings. Do not hardcode commit SHAs —
# leave INSIDER_RELEASE / GIT_SHA unset so the SDK reads git HEAD locally.
# INSIDER_DSN=https://<beacon_token>@localhost:8000/<project_uuid>
INSIDER_ENVIRONMENT=development
INSIDER_DEBUG=true
# INSIDER_RELEASE=
# GIT_SHA=
